# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://teamora:teamora@localhost:5432/teamora?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional AI (server only — never expose to FE)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Email (EMAIL_PROVIDER=log logs only; later resend/ses)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@teamora.local

# Cookie sessions (httpOnly access + refresh; readable CSRF double-submit)
# Required in production with Secure cookies over HTTPS:
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# CORS_ORIGINS=https://app.example.com  (no wildcards)
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: min 32 chars (boot fails if shorter in production)

# Seed platform super-admin
SEED_ADMIN_EMAIL=admin@teamora.local
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
SEED_ADMIN_NAME=Platform Super Admin
