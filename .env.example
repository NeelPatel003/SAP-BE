# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://teamora:teamora@localhost:5432/teamora?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional AI (server only — never expose to FE)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Soft daily call cap per company (free-tier guard)
AI_DAILY_CALL_LIMIT=25

# Email (EMAIL_PROVIDER=log logs only; later resend/ses)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@teamora.local

# Cookie sessions (httpOnly access + refresh; readable CSRF double-submit)
# Required in production with Secure cookies over HTTPS:
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# COOKIE_SAMESITE=none   # required when FE and BE are on different hosts (Vercel + Render)
# CORS_ORIGINS=https://app.example.com  (no wildcards)
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: min 32 chars (boot fails if shorter in production)

# Seed platform super-admin
SEED_ADMIN_EMAIL=admin@teamora.local
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
SEED_ADMIN_NAME=Platform Super Admin

# Keep-warm (in-process cron every 5 minutes → GET /health)
# On in production by default. Set KEEP_WARM_ENABLED=false to disable.
# Prefer the public Render URL so traffic resets free-tier idle timer:
# KEEP_WARM_URL=https://your-service.onrender.com/health
# (or set RENDER_EXTERNAL_HOSTNAME — Render often injects this)
KEEP_WARM_ENABLED=true
# KEEP_WARM_URL=https://your-service.onrender.com/health

# Razorpay — future payment phase only (not wired; leave unset)
# Prerequisites: stable supplier invoice verify + accounts booking.
# See docs/razorpay-future.md
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
